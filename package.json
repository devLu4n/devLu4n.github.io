{
  "name": "aladin-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names backend,frontend --prefix-colors blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix backend test -- --runInBand",
    "audit": "npm --prefix frontend audit && npm --prefix backend audit"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
